# Словарь ожиданий AT-модема.  Формат строки:  <шаблон>=<ответ>
#
# Синтаксис шаблона (собственный матчер, regex-библиотеки не используются):
#   .        ровно один любой символ
#   *        ноль или более любых символов
#   [abc]    один символ из набора; диапазоны [0-9] и инверсия [^0-9]
#   \x       экранирование: \. \* \[ \\ \=
#
# Разделителем считается ПЕРВЫЙ НЕЭКРАНИРОВАННЫЙ '='. Если '=' нужен внутри
# самой AT-команды (AT+CPIN=1234), в шаблоне пишите \= — см. примеры ниже.
#
# В ответе разворачиваются \r \n \t \e \\ . Обрамление ответа <CR><LF> сервер
# добавляет сам, поэтому здесь пишется только тело.
#
# Макросы %CME <код>% и %CMS <код>% разворачиваются по текущему режиму AT+CMEE:
#   +CMEE=0 (по умолчанию) -> ERROR
#   +CMEE=1                -> +CME ERROR: 16
#   +CMEE=2                -> +CME ERROR: incorrect password
# Литеральный процент пишется как %%. Жёсткий текст ошибки писать тоже можно —
# он уйдёт клиенту как есть, независимо от +CMEE.
#
# S-регистры (ATS3?, ATS3=13) и составные строки (AT+CSQ;+CREG?) обрабатывает
# сам сервер, отдельных правил для них не нужно.
#
# Правила проверяются СВЕРХУ ВНИЗ, срабатывает первое подошедшее:
# специфичные шаблоны держите выше общих.
#
# Сопоставление регистронезависимое (ключ --case-sensitive это отключает),
# поэтому отдельные строки для "at" и "AT" не нужны.

# ---------------------------------------------------------------- базовый набор
AT=OK

# ATE[1,0] из задания: набор символов {0,1}. Голое ATE эквивалентно ATE0.
ATE[01]=OK
ATE=OK

# ATI и его нумерованные варианты ATI0..ATI9 (демонстрация класса с диапазоном)
ATI=NDM Systems\r\nNDM-LTE-1000\r\nRevision: 1.4.2-ndm\r\n\r\nOK
ATI[0-9]=NDM-LTE-1000\r\n\r\nOK

# --------------------------------------------------------------------- AT+COPS
# Порядок важен: сначала точные формы ? и =?, затем общая форма записи.
AT+COPS?=+COPS: 0,0,"MegaFon",7\r\n\r\nOK
AT+COPS\=?=+COPS: (2,"MegaFon","MegaFon","25002",7),(1,"MTS","MTS","25001",7),(1,"Beeline","Beeline","25099",7),,(0,1,2,3,4),(0,1,2)\r\n\r\nOK
AT+COPS\=*=OK

# --------------------------------------------------------------------- AT+CPIN
AT+CPIN?=+CPIN: READY\r\n\r\nOK
AT+CPIN\=?=OK
# Любой четырёхзначный PIN считаем верным, всё остальное — отбой.
AT+CPIN\=[0-9][0-9][0-9][0-9]=OK
AT+CPIN\=*=%CME 16%

# ------------------------------------------------------- прочая типовая обвязка
ATZ=OK
AT&F*=OK
ATH=OK
ATA=NO CARRIER
AT+GMI=NDM Systems\r\n\r\nOK
AT+GMM=NDM-LTE-1000\r\n\r\nOK
AT+GMR=1.4.2-ndm\r\n\r\nOK
AT+CGMI=NDM Systems\r\n\r\nOK
AT+CGMM=NDM-LTE-1000\r\n\r\nOK
AT+CGSN=867435041234567\r\n\r\nOK
AT+CIMI=250029876543210\r\n\r\nOK
AT+CSQ=+CSQ: 21,99\r\n\r\nOK
AT+CREG?=+CREG: 0,1\r\n\r\nOK
AT+CGREG?=+CGREG: 0,1\r\n\r\nOK
AT+CGATT?=+CGATT: 1\r\n\r\nOK
# '.' — ровно один символ: AT+CFUN=0, AT+CFUN=1, AT+CFUN=4 ...
AT+CFUN\=.=OK
AT+CFUN?=+CFUN: 1\r\n\r\nOK
AT+CMEE\=[0-2]=OK

# Раскомментируйте, чтобы отвечать OK на любую нераспознанную AT-команду
# вместо ERROR. Строка обязана оставаться последней.
# AT*=OK
